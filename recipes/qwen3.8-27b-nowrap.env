# Recipe: Qwen3.8-27B on Scanner/NoWrap-v1 by reinforcement learning (LoRA + GRPO in verl, reward = pass).
# The settings of the run that checks the recipe on the published code; docs/RECIPE.md has the steps and the result.
#
#   cp recipes/qwen3.8-27b-nowrap.env my.env          # fill the four FILL_IN lines; my.env stays outside the repository
#   bash integrations/verl/node/make_main.sh train my.env job.sh
#
# Every variable is documented at the top of integrations/verl/node/train.sh, calibrate.sh and integrations/verl/overrides.sh.

# ---- yours to fill
RUN_ID=FILL_IN_a_name_for_this_run                    # a new name per launch: a finished run id is never started again
OUT_URI=FILL_IN_where_the_run_writes                  # an object-store prefix the node can write to
REPO_SRC=FILL_IN_this_repository                      # git+<clone URL>@<commit>, an archive, or a folder on the node
SECRET_URI=FILL_IN_your_key_file                      # made once by `mrgym epoch keygen --out secret.key`; never the key itself

# ---- model: thinking off, short replies, so that an episode fits one accelerator as a single token stream
MODEL_HF=Qwen/Qwen3.8-27B
MODEL_NAME=policy
TOOL_FORMAT=qwen3_coder
CHAT_KWARGS=enable_thinking=False
MAX_TOKENS_PER_TURN=2048

# ---- cells: train on the level the untrained model sometimes passes and the next one; read out one level further
TRAIN_ARMS="Scanner/NoWrap-v1:1,2"
DEV_ARMS="Scanner/NoWrap-v1:1,2,3"
DEV_SEEDS=0-31
VAL_N=2
TEST_ARMS="Scanner/NoWrap-v1:1,2,3 Scanner/NullTissue-v0:0"
TEST_SEEDS=0-47
UNTRAINED="Scanner/NullTissue-v0"

# ---- memory: two rollout replicas of four accelerators; one longest episode per accelerator in the update
ROLLOUT_TP=4
GPU_MEM_UTIL=0.60
MAX_PROMPT_LEN=8192
MAX_RESPONSE_LEN=49152
TOKENS_PER_GPU=59392                                  # MAX_PROMPT_LEN + MAX_RESPONSE_LEN + 2048

# ---- optimisation
LORA_RANK=32
LORA_ALPHA=64
LR=1e-5
WARMUP_STEPS=5
KL_COEF=0
PROMPTS_PER_STEP=8
GROUP_SIZE=8
TOTAL_STEPS=60
SAVE_FREQ=5
TEST_FREQ=10
SIGNAL=pass
CURRICULUM_MODE=bandit

# ---- stop rules and the readout rule (the other rules keep the defaults of train.sh)
CUT_MAX=0.50
SUBMIT_MIN=0.40
MIXED_MIN=0.30
BASE_RATE=0.30
MIN_ENVS=1

# ---- calibration (read by calibrate.sh only): the same model setting, 8 instances x 8 episodes per level
REASONING=off
CAL_PLAN="Scanner/NoWrap-v1:1,2,3"
CAL_N=8
CAL_K=8
CAL_MAX_TOKENS=2048
