# Settings of docs/experiments/PREREG-27b.md as the environment variables of integrations/verl/node/train.sh (and of
# train_smoke.sh, which takes the model and memory lines). Nothing here launches anything. Values marked (cal) are
# filled from the calibration job's train_arms.json; values marked (smoke) may only change in the direction the
# training smoke measured, and such a change is written into the pre-registration before the run starts.
MODEL_HF=Qwen/Qwen3.8-27B
MODEL_NAME=policy
TOOL_FORMAT=qwen3_coder
CHAT_KWARGS=reasoning_effort=medium     # the reasoning setting of the calibration (cal)
ROLLOUT_TP=4                            # two rollout replicas of four GPUs each
GPU_MEM_UTIL=0.60                       # share of each GPU the rollout replicas may take while they are awake (smoke)
MAX_PROMPT_LEN=8192
MAX_RESPONSE_LEN=24576                  # (smoke) the largest stream that fits the actor on the node's cards
MAX_TOKENS_PER_TURN=16384
TOKENS_PER_GPU=34816                    # MAX_PROMPT_LEN + MAX_RESPONSE_LEN + 2048: one longest episode per GPU and micro-batch
LORA_RANK=32
LORA_ALPHA=64
LR=1e-5
WARMUP_STEPS=5
GRAD_CLIP=1.0
KL_COEF=0
PROMPTS_PER_STEP=16
GROUP_SIZE=8
TOTAL_STEPS=60
SAVE_FREQ=5
TEST_FREQ=10
VAL_N=2
DEV_SEEDS=0-31
TEST_SEEDS=0-149
SIGNAL=pass
CURRICULUM_MODE=bandit
SEED=1                                  # arm R1; 2 for R2
NO_REWARD_STEPS=4
NO_REWARD_MIN=0.02
HARNESS_STEPS=10
MIXED_MIN=0.40
SUBMIT_MIN=0.50
CUT_MAX=0.20
WINDOW=5
COLLAPSE_STEPS=10
ALPHA=0.05
LOOKS=6
MDE=0.05
FUTILITY_FROM_STEP=30
MASTERED=0.90
GAIN=0.15
LOWER=0.05
HARM=0.05
MIN_ENVS=2
# TRAIN_ARMS / ARMS_URI, BASE_RATE, TEST_ARMS, UNTRAINED: from the calibration (cal)
# RUN_ID, OUT_URI, REPO_SRC, SECRET_URI: given by whoever launches; never written into this repository
