# Settings of the arms of docs/experiments/PREREG-learnability.md, as the environment variables that the project's verl
# adapter reads before it builds its Hydra overrides (the adapter is not part of this repository). Variables not
# listed keep the adapter's defaults. Nothing here launches anything.
MODEL_PATH=Qwen/Qwen3.5-9B
TOOL_FORMAT=qwen3_coder
ENABLE_THINKING=False            # the reasoning setting is fixed by the calibration (plan, section 2)
PROMPTS_PER_STEP=16              # groups per step
GROUP_SIZE=8
MAX_TURNS=12
LORA_RANK=32
LORA_ALPHA=64
LR=1e-5
KL_COEF=0
FILTER_GROUPS=False              # groups without spread get zero advantage; they are counted from the rollout records, not refilled
TOTAL_STEPS=120
SAVE_FREQ=10
TEST_FREQ=30                     # the dev evaluation of the plan
MAX_PROMPT_LEN=8192              # level 0 states the procedure: its first prompt is longer than the adapter default assumes
MAX_RESPONSE_LEN=24576
MRGYM_ENV=Scanner/NullTissue-v0
MRGYM_LEVELS=0,1,2
TRAIN_SEEDS=10000-11919          # 16 x 120 instances: arm U reads them from a static file; R and G take seeds from the curriculum
VAL_SEEDS=0-63
